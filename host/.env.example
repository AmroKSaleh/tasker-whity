# Tasker's own whity-core host. Ports deliberately differ from any other
# whity deployment on this machine so the two never collide.
APP_ENV=development

DB_HOST=postgres
DB_PORT=5432
DB_NAME=tasker
DB_USER=tasker
DB_PASSWORD=tasker_dev

JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
ENCRYPTION_KEY=dev-only-encryption-key-change-me-32ch

CORS_ALLOWED_ORIGINS=http://localhost:5174

FRANKENPHP_WORKERS=4
MAX_REQUESTS=500
WORKER_MEMORY_LIMIT_MB=128

INITIAL_ADMIN_PASSWORD=admin123
INITIAL_USER_PASSWORD=user123

# Infrastructure-level MCP gate (WC-c10b292e / McpTransportHandler::$enabled).
# Without this, POST /mcp returns a bare 503 for every caller regardless of
# auth or the per-tenant mcp.enabled setting. See docs/mcp-tool-surface.json's
# generating script and the README dev-loop notes for the full enablement story.
MCP_ENABLED=true
