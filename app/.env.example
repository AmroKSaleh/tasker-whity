# TEMPORARY SCAFFOLDING — Task 6 (Plan A), removed once Plan C de-Supabases
# the copied SPA.
#
# src/lib/supabase.js calls createClient(VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY)
# at module load time (not inside a function), and App.jsx statically imports
# AuthGuard, which statically imports src/lib/supabase.js. So without these
# two variables set, createClient() throws synchronously ("supabaseUrl is
# required.") and the ENTIRE app fails to boot — including routes with
# nothing to do with Supabase, like /dev/ping.
#
# Copy this file to .env.local (gitignored) before running `npm run dev` or
# `npm run build` in this directory:
#
#   cp .env.example .env.local
#
# These are NOT real credentials — no code added for Task 6 talks to
# Supabase. Delete this file and .env.local once Plan C removes the
# Supabase dependency.

VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-not-a-real-credential
